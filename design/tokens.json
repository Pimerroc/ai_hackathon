{
  "$description": "Альфа-Инсайт · design tokens v0 (#7). Формат W3C Design Tokens (DTCG). Источник правды для apps/web; CSS-переменные генерируются в design/tokens.css командой `python design/tokens_tool.py css`.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#F3F4F6", "$description": "Фон приложения" },
    "surface": { "$value": "#FFFFFF", "$description": "Карточки, панели, header" },
    "surface-subtle": { "$value": "#F8F9FA", "$description": "Вложенные блоки внутри карточки" },
    "surface-hover": { "$value": "#EEF0F3", "$description": "Hover нейтральных элементов" },
    "surface-pressed": { "$value": "#E4E7EB", "$description": "Pressed / selected нейтральных элементов" },
    "surface-inverse": { "$value": "#0B1F35", "$description": "Тёмные подсказки и тосты" },
    "border": { "$value": "#DCE0E5", "$description": "Разделители и рамки карточек" },
    "border-strong": { "$value": "#848E9B", "$description": "Рамки полей ввода (≥ 3:1 к surface)" },
    "text": { "$value": "#0B1F35", "$description": "Основной текст" },
    "text-secondary": { "$value": "#4B5868", "$description": "Подписи, why-in-feed" },
    "text-tertiary": { "$value": "#5F6B7A", "$description": "Мета: время, источник (AA на bg и surface)" },
    "text-disabled": { "$value": "#A3ABB5", "$description": "Только для disabled (WCAG-исключение)" },
    "text-inverse": { "$value": "#FFFFFF" },
    "accent": { "$value": "#EF3124", "$description": "Фирменный красный: полоса позиции банка, иконки, маркер. Не для мелкого текста" },
    "accent-subtle": { "$value": "#FFEEEC" },
    "action": { "$value": "#D31F12", "$description": "Primary-кнопка (белый текст ≥ 4.5:1)" },
    "action-hover": { "$value": "#B81A0F" },
    "action-pressed": { "$value": "#9C160C" },
    "link": { "$value": "#1557C0" },
    "focus": { "$value": "#1F6FEB", "$description": "Кольцо фокуса, ≥ 3:1 к фону" },
    "risk": { "$value": "#B4400A", "$description": "Риск. Намеренно оранжево-красный, не фирменный красный, чтобы не путать с позицией банка" },
    "risk-subtle": { "$value": "#FFF1E8" },
    "risk-border": { "$value": "#F5C7AA" },
    "opportunity": { "$value": "#0C7438" },
    "opportunity-subtle": { "$value": "#E8F6EE" },
    "opportunity-border": { "$value": "#A8DCBD" },
    "neutral": { "$value": "#4B5868" },
    "neutral-subtle": { "$value": "#EEF0F3" },
    "neutral-border": { "$value": "#D3D8DE" },
    "fact": { "$value": "#265A8D", "$description": "Бейдж «Факт»" },
    "fact-subtle": { "$value": "#EAF2FA" },
    "fact-border": { "$value": "#BBD3EA" },
    "bank": { "$value": "#BF190D", "$description": "Бейдж «Позиция Альфа-Банка»; полоса цитаты — color.accent" },
    "bank-subtle": { "$value": "#FFEEEC" },
    "bank-border": { "$value": "#F8C3BD" },
    "ai": { "$value": "#6337C2", "$description": "Бейдж «Вывод AI»" },
    "ai-subtle": { "$value": "#F2EDFD" },
    "ai-border": { "$value": "#D4C4F5" },
    "estimate": { "$value": "#875100", "$description": "Бейдж «Оценка»; рамка пунктирная" },
    "estimate-subtle": { "$value": "#FFF5DA" },
    "estimate-border": { "$value": "#E2B65C" },
    "success": { "$value": "{color.opportunity}" },
    "success-subtle": { "$value": "{color.opportunity-subtle}" },
    "warning": { "$value": "{color.estimate}" },
    "warning-subtle": { "$value": "{color.estimate-subtle}" },
    "danger": { "$value": "#C42318", "$description": "Ошибки системы (не путать с риском события)" },
    "danger-subtle": { "$value": "#FDECEA" },
    "info": { "$value": "#1557C0" },
    "info-subtle": { "$value": "#EAF1FD" },
    "info-border": { "$value": "#BED3F6" },
    "meter-fill": { "$value": "{color.text}", "$description": "Заполненный сегмент шкалы уверенности" },
    "meter-track": { "$value": "#D3D8DE" },
    "skeleton": { "$value": "#E6E9ED" },
    "skeleton-highlight": { "$value": "#F4F5F7" },
    "overlay": { "$value": "#0B1F3566", "$description": "Подложка модальных листов на мобильном" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Inter", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$description": "В проде — фирменный шрифт Альфа-Бизнеса; в прототипе Inter (OFL), есть кириллица" },
      "mono": { "$value": ["JetBrains Mono", "Consolas", "ui-monospace", "monospace"], "$description": "Trace: run_id, модели, токены" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.bold}", "fontSize": "32px", "lineHeight": "40px", "letterSpacing": "-0.01em" } },
    "h1": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.bold}", "fontSize": "26px", "lineHeight": "34px", "letterSpacing": "-0.01em" } },
    "h2": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "20px", "lineHeight": "28px", "letterSpacing": "0em" } },
    "h3": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "17px", "lineHeight": "24px", "letterSpacing": "0em" } },
    "body": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0em" } },
    "body-strong": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0em" } },
    "small": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.regular}", "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "0em" } },
    "caption": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.medium}", "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.01em" } },
    "label": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": "{font.weight.semibold}", "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.02em" } },
    "mono": { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": "{font.weight.regular}", "fontSize": "12px", "lineHeight": "18px", "letterSpacing": "0em" } }
  },
  "space": {
    "$type": "dimension",
    "$description": "Шаг 4px; индекс как в Tailwind: space.4 = 16px",
    "0": { "$value": "0px" },
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px", "$description": "Бейджи, source chip" },
    "md": { "$value": "10px", "$description": "Поля ввода, вложенные блоки" },
    "control": { "$value": "12px", "$description": "Кнопки, вкладки" },
    "card": { "$value": "16px", "$description": "Карточки ленты и блоки инсайта" },
    "panel": { "$value": "20px", "$description": "Мобильный лист, крупные виджеты" },
    "pill": { "$value": "999px", "$description": "Чипы, теги влияния, аватар" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": [
      { "color": "#0B1F350F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "#0B1F350A", "offsetX": "0px", "offsetY": "1px", "blur": "1px", "spread": "0px" }
    ] },
    "raised": { "$value": [
      { "color": "#0B1F3514", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "0px" },
      { "color": "#0B1F350A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
    ], "$description": "Hover карточки ленты" },
    "popover": { "$value": [
      { "color": "#0B1F351F", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }
    ] },
    "panel": { "$value": [
      { "color": "#0B1F3514", "offsetX": "-4px", "offsetY": "0px", "blur": "24px", "spread": "0px" }
    ], "$description": "Боковая панель чата / trace" }
  },
  "focus": {
    "$type": "dimension",
    "width": { "$value": "2px" },
    "offset": { "$value": "2px" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms", "$description": "hover, press" },
      "base": { "$value": "200ms", "$description": "раскрытие, вкладки" },
      "slow": { "$value": "320ms", "$description": "панели" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  },
  "layout": {
    "$type": "dimension",
    "header-height": { "$value": "64px" },
    "sidebar-width": { "$value": "240px" },
    "content-max": { "$value": "1120px" },
    "insight-max": { "$value": "760px" },
    "panel-width": { "$value": "460px", "$description": "Чат и trace на desktop" },
    "bp-mobile": { "$value": "390px" },
    "bp-tablet": { "$value": "768px" },
    "bp-desktop": { "$value": "1280px" }
  },
  "z": {
    "$type": "number",
    "header": { "$value": 10 },
    "panel": { "$value": 30 },
    "overlay": { "$value": 40 },
    "drawer": { "$value": 50 },
    "toast": { "$value": 60 }
  }
}
